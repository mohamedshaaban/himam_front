# Base URL of the deployed Himam API, including the /api suffix.
#
# Leave this unset for local development: the Vite dev server proxies /api to
# http://127.0.0.1:8000 so the browser stays on one origin.
#
# Set it on your host (Cloudflare Pages / Netlify / Vercel) at build time —
# Vite inlines VITE_* variables into the bundle, so it must be present when
# `npm run build` runs, not at runtime.
VITE_API_URL=https://your-api-host.example.com/api
